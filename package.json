{
	"name": "namaewanam.github.io",
	"version": "0.0.1",
	"private": true,
	"packageManager": "pnpm@9.15.4",
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=9.0.0"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"generate:resources": "tsx scripts/generate-feeds.ts",
		"predev": "pnpm generate:resources",
		"build:feeds": "pnpm generate:resources",
		"prebuild": "pnpm generate:resources",
		"build": "next build",
		"analyze": "ANALYZE=true pnpm build",
		"check:links": "tsx scripts/check-static-links.ts",
		"check:feeds": "tsx scripts/verify-feeds.ts",
		"start": "next start",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
		"format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
		"type-check": "tsc --noEmit",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix"
		],
		"*.{js,jsx,ts,tsx,json,css,md}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@giscus/react": "^3.1.0",
		"fuse.js": "^7.5.0",
		"glob": "^13.0.6",
		"gray-matter": "^4.0.3",
		"lucide-react": "^0.545.0",
		"mermaid": "^12.1.0",
		"next": "16.4.0",
		"pako": "^2.2.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"rehype-highlight": "^7.0.2",
		"rehype-raw": "^7.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@eslint/eslintrc": "^3.3.7",
		"@next/bundle-analyzer": "15.5.18",
		"@tailwindcss/typography": "^0.5.20",
		"@types/node": "^20.19.43",
		"@types/pako": "^2.0.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript-eslint/eslint-plugin": "8.59.4",
		"@typescript-eslint/parser": "8.59.4",
		"autoprefixer": "^10.6.1",
		"eslint": "8.57.1",
		"eslint-config-next": "15.5.18",
		"eslint-config-prettier": "^10.1.8",
		"fast-xml-parser": "^5.11.2",
		"feed": "^5.2.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"postcss": "^8.5.29",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"tailwindcss": "^3.4.19",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3"
	},
	"pnpm": {
		"overrides": {
			"postcss-selector-parser": ">=7.1.6",
			"katex": ">=0.18.2",
			"sprintf-js": ">=1.1.3"
		}
	}
}
