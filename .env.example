# Copy this file to .env.local and fill in values.
# .env.local is gitignored and never committed.

# Site & Identity Configuration
# Defaults to values in src/lib/site.ts if omitted
NEXT_PUBLIC_SITE_NAME=nam
NEXT_PUBLIC_SITE_URL=https://namaewanam.github.io
NEXT_PUBLIC_STATUS_LINE="building boring systems"
NEXT_PUBLIC_SITE_DESCRIPTION="Notes, articles and thoughts from a backend developer"
NEXT_PUBLIC_CONTACT_EMAIL=namisme16052004@gmail.com
NEXT_PUBLIC_GITHUB_USERNAME=ntnam1605
NEXT_PUBLIC_GITHUB_OWNER=namaewanam
NEXT_PUBLIC_GITHUB_REPO=namaewanam.github.io

# Giscus — GitHub Discussions comments
# Get values at: https://giscus.app
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Resume PDF — override to point at Google Drive
# Default: /cv.pdf (served from public/cv.pdf)
# NEXT_PUBLIC_RESUME_URL=https://drive.google.com/file/d/YOUR_FILE_ID/view?usp=sharing

# Newsletter — Buttondown username for subscribe form
# Sign up at: https://buttondown.com
NEXT_PUBLIC_BUTTONDOWN_USERNAME=your-username

# Buttondown API Automation (for automated post notifications)
# Get your free API key at: https://buttondown.com/settings/programming
# In production, add this as a secret in GitHub Settings -> Secrets -> Actions:
# BUTTONDOWN_API_KEY=your-api-key
# Status can be "draft" (default, review before sending) or "about_to_send" (auto-send immediately):
# BUTTONDOWN_EMAIL_STATUS=draft

# Feature toggles
# All features are ENABLED by default.
# Set to "false" or "0" to disable a feature.

# Existing features
NEXT_PUBLIC_FEATURE_COMMENTS=true          # Giscus comment widget on blog posts
NEXT_PUBLIC_FEATURE_READING_PROGRESS=true  # Reading progress bar
NEXT_PUBLIC_FEATURE_COMMAND_PALETTE=true   # ⌘K command palette
NEXT_PUBLIC_FEATURE_WEB_VITALS=true        # Core Web Vitals reporting
NEXT_PUBLIC_FEATURE_BACK_TO_TOP=true       # Back-to-top floating button
NEXT_PUBLIC_FEATURE_SHORTCUT_HELP=true     # Keyboard shortcut help overlay
NEXT_PUBLIC_FEATURE_FEEDS=true             # RSS / Atom / JSON feed links

# New features
NEXT_PUBLIC_FEATURE_SHARE_BUTTONS=true     # Share buttons on blog posts
NEXT_PUBLIC_FEATURE_POST_REACTIONS=true    # Emoji reactions on blog posts
NEXT_PUBLIC_FEATURE_READING_LIST=true      # Bookmark / reading list
NEXT_PUBLIC_FEATURE_NOW_PAGE=true          # /now page
NEXT_PUBLIC_FEATURE_CHANGELOG=true         # /changelog page
NEXT_PUBLIC_FEATURE_TAGS_BROWSING=true     # /blog/tags page
NEXT_PUBLIC_FEATURE_POST_STATS=true        # Blog stats on home page
NEXT_PUBLIC_FEATURE_NEWSLETTER=true        # Newsletter subscribe form
NEXT_PUBLIC_FEATURE_I18N=true              # i18n language switcher
NEXT_PUBLIC_FEATURE_INTERACTIVE_CODE=true  # Playground links on code blocks
NEXT_PUBLIC_FEATURE_EDITOR=true            # Web markdown editor (/editor)
NEXT_PUBLIC_FEATURE_STACK=true             # Tech radar (/stack) page
NEXT_PUBLIC_FEATURE_SNIPPETS=true          # Code snippets (/snippets) page
NEXT_PUBLIC_FEATURE_ADR=true               # Architecture Decision Records (/adr) page
NEXT_PUBLIC_FEATURE_RELATED_POSTS=true     # Related posts section on articles
NEXT_PUBLIC_FEATURE_TABLE_OF_CONTENTS=true # Table of contents sidebar on articles
